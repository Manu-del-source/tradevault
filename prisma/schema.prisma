generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TradeSide {
  LONG
  SHORT
}

enum TradeSource {
  MANUAL
  CSV
  MT5
  DERIV
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String   @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  accounts     TradingAccount[]
  sessions     Session[]
  oauthStates  DerivOAuthState[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model DerivOAuthState {
  id                String   @id @default(cuid())
  state             String   @unique
  userId            String
  accountId         String
  codeVerifier      String
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model TradingAccount {
  id        String   @id @default(cuid())
  userId    String
  name      String
  broker    String?
  accountId String?
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades    Trade[]
  mt5SyncCredential Mt5SyncCredential?
  derivCredential DerivOAuthCredential?
  @@index([userId])
}

model DerivOAuthCredential {
  id                 String         @id @default(cuid())
  accountId          String         @unique
  derivAccountId     String
  accessToken        String
  refreshToken       String?
  expiresAt          DateTime?
  lastSyncAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  account            TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([derivAccountId])
}

model Mt5SyncCredential {
  id         String         @id @default(cuid())
  accountId  String         @unique
  tokenHash  String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lastUsedAt DateTime?
  account    TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Trade {
  id           String         @id @default(cuid())
  accountId    String
  externalId   String?
  positionId   String?
  contractType String?
  symbol       String
  side         TradeSide
  pnl          Decimal        @db.Decimal(18, 2)
  entryPrice   Decimal?       @db.Decimal(18, 8)
  exitPrice    Decimal?       @db.Decimal(18, 8)
  volume       Decimal?       @db.Decimal(18, 4)
  stopLoss     Decimal?       @db.Decimal(18, 8)
  takeProfit   Decimal?       @db.Decimal(18, 8)
  strategy     String?
  session      String?
  notes        String?
  openedAt     DateTime?
  closedAt     DateTime?
  source       TradeSource    @default(MANUAL)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  account      TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, externalId])
  @@index([accountId, closedAt])
  @@index([accountId, symbol])
  @@index([accountId, positionId])
}
